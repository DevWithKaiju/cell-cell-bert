# ===================================================================
#  Project-specific ignores for AI/ML Projects
# ===================================================================

# Experiment results (models, logs, figures, etc.)
/results/
*.log

# Container image (symlink to local build; rebuild via pyproject.toml/uv.lock instead)
env.sif

# Secrets and local settings
.env
.env.*
local_settings.py

# 検証用ノートブック（APIキー等の秘密情報が実行結果セルに紛れ込みやすいため追跡しない）
data/test.ipynb


# ===================================================================
#  Virtual environments
# ===================================================================
.venv/
venv/
env/
ENV/
__pypackages__/


# ===================================================================
#  Python cache and build artifacts
# ===================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg


